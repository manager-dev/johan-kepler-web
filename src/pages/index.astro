---
// src/pages/index.astro
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

// Reemplazar con las URLs finales cuando las tengas
const OFFICIAL_FACEBOOK = "https://facebook.com";
const OFFICIAL_YOUTUBE = "https://youtube.com";
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Colegio Cristiano Johan Kepler</title>
</head>
<body class="bg-slate-950 min-h-screen flex flex-col justify-between text-slate-100 font-sans">

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex-grow">
    <!-- Banner Principal -->
    <Hero facebookUrl={OFFICIAL_FACEBOOK} />

    <!-- Resto del contenido -->
</main>

<!-- Footer Institucional -->
<Footer
        facebookUrl={OFFICIAL_FACEBOOK}
        youtubeUrl={OFFICIAL_YOUTUBE}
/>
</body>
</html>