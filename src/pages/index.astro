---
// src/pages/index.astro
import SocialCard from '../components/SocialCard.astro';
import Footer from '../components/Footer.astro';

const OFFICIAL_FACEBOOK = "https://www.facebook.com/share/1DzYBSxGJ1/?mibextid=wwXIfr";
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Colegio Cristiano Johan Kepler</title>
</head>
<body class="bg-slate-950 min-h-screen flex flex-col justify-between text-slate-100 font-sans">

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex-grow py-8">

    <!-- Encabezado Institucional Principal -->
    <header class="py-12 text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
            Colegio Cristiano Johan Kepler
        </h1>
        <p class="text-lg text-slate-300">
            Educación integral basada en excelencia académica, ciencia y valores bíblicos.
        </p>
    </header>

    <!-- Bloque / Contenido Institucional de la Web (Expediente, Oferta, etc.) -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-8 text-center text-slate-400">
        <p>Sección principal del contenido de la web del colegio...</p>
    </div>

    <!-- Tarjeta de Medios Activos (Facebook) situada hacia el final -->
    <SocialCard facebookUrl={OFFICIAL_FACEBOOK} />

</main>

<!-- Footer Institucional -->
<Footer facebookUrl={OFFICIAL_FACEBOOK} />
</body>
</html>