---
// src/pages/index.astro
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import SocialCard from "../components/SocialCard.astro";
import AdministrativeServices from "../components/AdministrativeServices.astro";
import VirtualTour from "../components/VirtualTour.astro";
import SemanarioSection from "../components/SemanarioSection.astro";

// Importación directa desde src/assets/
import logoImg from "../assets/logo.png";
import fachadaImg from "../assets/fachada.jpg";

// URL Oficial de Facebook
const OFFICIAL_FACEBOOK =
  "https://www.facebook.com/share/1DzYBSxGJ1/?mibextid=wwXIfr";

// Obtener noticias ordenadas por fecha descendente
const todasLasNoticias = (await getCollection("noticias")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Extraer aviso urgente si existe
const avisoUrgente = todasLasNoticias.find((n) => n.data.urgent === true);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Colegio Johan Kepler - Soyapango</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-kepler-aqua font-sans text-slate-900 antialiased">
    <!-- NAVEGACIÓN PRINCIPAL -->
    <nav
      class="fixed z-50 w-full border-b-8 border-kepler-gold bg-white shadow-xl"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-24 items-center justify-between">
          <!-- Logo e Identidad -->
          <a href="/" class="flex items-center gap-4">
            <div
              class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border-2 border-slate-200 bg-white md:h-16 md:w-16"
            >
              <Image
                src={logoImg}
                alt="Logo Colegio Johan Kepler"
                class="h-full w-full object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span
                class="text-2xl font-black uppercase leading-none tracking-tighter text-black"
                >Colegio</span
              >
              <span
                class="text-xl font-bold leading-none tracking-tight text-kepler-red"
                >Johan Kepler</span
              >
            </div>
          </a>

          <!-- Menú Escritorio -->
          <div class="hidden items-center gap-6 lg:flex">
            <a
              href="/acerca-de-nosotros"
              class="text-xs font-black uppercase tracking-widest text-black transition-colors hover:text-kepler-red"
              >Nosotros</a
            >
            <a
              href="#modelo"
              class="text-xs font-black uppercase tracking-widest text-black transition-colors hover:text-kepler-red"
              >Modelo Educativo</a
            >
            <a
              href="#niveles"
              class="text-xs font-black uppercase tracking-widest text-black transition-colors hover:text-kepler-red"
              >Niveles</a
            >
            <a
              href="#recorrido"
              class="text-xs font-black uppercase tracking-widest text-black transition-colors hover:text-kepler-red"
              >Recorrido</a
            >
            <a
              href="#servicios-admin"
              class="text-xs font-black uppercase tracking-widest text-black transition-colors hover:text-kepler-red"
              >Servicios Admin</a
            >
            <a
              href="#ubicacion"
              class="text-xs font-black uppercase tracking-widest text-black transition-colors hover:text-kepler-red"
              >Ubicación</a
            >
            <a
              href="/expediente"
              class="rounded border-2 border-kepler-red px-4 py-2 text-xs font-black uppercase text-kepler-red transition-colors hover:bg-red-50"
              >Expediente</a
            >
          </div>

          <!-- Botón Menú Móvil -->
          <button
            id="menu-btn"
            class="rounded bg-slate-100 p-2 text-black lg:hidden"
            aria-label="Abrir menú"
          >
            <svg
              class="h-8 w-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M4 6h16M4 12h16m-7 6h7"></path></svg
            >
          </button>
        </div>
      </div>

      <!-- Menú Móvil Desplegable -->
      <div
        id="mobile-menu"
        class="hidden space-y-4 border-t border-slate-100 bg-white p-6 shadow-lg lg:hidden"
      >
        <a
          href="/acerca-de-nosotros"
          class="mobile-link block text-sm font-black uppercase text-kepler-red"
          >Nosotros</a
        >
        <a
          href="#modelo"
          class="mobile-link block text-sm font-black uppercase text-black"
          >Modelo Educativo</a
        >
        <a
          href="#niveles"
          class="mobile-link block text-sm font-black uppercase text-black"
          >Niveles</a
        >
        <a
          href="#recorrido"
          class="mobile-link block text-sm font-black uppercase text-black"
          >Recorrido</a
        >
        <a
          href="#servicios-admin"
          class="mobile-link block text-sm font-black uppercase text-black"
          >Servicios Admin</a
        >
        <a
          href="#ubicacion"
          class="mobile-link block text-sm font-black uppercase text-black"
          >Ubicación</a
        >
        <a
          href="/expediente"
          class="block w-full rounded bg-kepler-red py-3 text-center font-black uppercase text-white"
          >Expediente</a
        >
      </div>
    </nav>

    <!-- ========================================== -->
    <!-- FRANJA DE EMERGENCIA / ALERTA URGENTE      -->
    <!-- ========================================== -->
    {
      avisoUrgente && (
        <aside class="fixed top-24 z-40 w-full border-b-2 border-kepler-gold bg-kepler-red px-4 py-2.5 text-white shadow-lg">
          <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 text-center sm:flex-row sm:text-left">
            <div class="flex items-center gap-2 text-sm font-bold tracking-wide">
              <span class="inline-flex h-2.5 w-2.5 animate-ping rounded-full bg-yellow-300" />
              <span class="rounded bg-black/40 px-2 py-0.5 text-[10px] font-black uppercase tracking-widest text-kepler-gold">
                Aviso Urgente
              </span>
              <span class="line-clamp-1">{avisoUrgente.data.title}</span>
            </div>
            <a
              href={`/noticias/${avisoUrgente.slug}`}
              class="whitespace-nowrap rounded bg-white px-3 py-1 text-[11px] font-black uppercase text-kepler-red shadow-sm transition-colors hover:bg-kepler-gold hover:text-black"
            >
              Leer comunicado &rarr;
            </a>
          </div>
        </aside>
      )
    }

    <main>
      <!-- SECCIÓN HERO -->
      <section
        class={`px-4 bg-white/60 backdrop-blur-sm relative overflow-hidden pb-20 ${avisoUrgente ? "pt-40" : "pt-32"}`}
      >
        <div
          class="pointer-events-none absolute right-0 top-0 flex h-full w-1/3 flex-col opacity-5"
        >
          <div class="h-1/3 bg-kepler-red"></div>
          <div class="h-1/3 bg-kepler-gold"></div>
          <div class="h-1/3 bg-black"></div>
        </div>

        <div
          class="relative z-10 mx-auto grid max-w-7xl items-center gap-12 text-left lg:grid-cols-2"
        >
          <div class="space-y-8">
            <div
              class="inline-flex items-center gap-2 rounded-md bg-kepler-red px-5 py-2 text-xs font-black uppercase tracking-[0.2em] text-white"
            >
              <span class="text-kepler-gold">●</span> Matrícula Abierta 2026
            </div>
            <h1
              class="text-5xl font-black leading-[0.9] text-black md:text-7xl"
            >
              TU FUTURO <br /> ESTÁ EN <br />
              <span class="text-kepler-red">TUS MANOS</span>
            </h1>
            <p
              class="max-w-lg text-xl font-medium leading-relaxed text-slate-700"
            >
              Excelencia académica en el corazón de <span
                class="font-black text-black">Soyapango</span
              >. Formamos líderes con valores y alta capacidad técnica.
            </p>
            <div class="flex flex-col gap-4 pt-4 sm:flex-row">
              <button
                class="hover:bg-kepler-redDark rounded-md border-b-4 border-black/20 bg-kepler-red px-10 py-4 font-black uppercase text-white shadow-md transition-all"
                >Inscribirme Ahora</button
              >
              <button
                class="hover:bg-kepler-goldDark rounded-md border-b-4 border-black/10 bg-kepler-gold px-10 py-4 font-black uppercase text-black shadow-md transition-all"
                >Tel: 2255-1500</button
              >
            </div>
          </div>

          <div class="relative">
            <div
              class="relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-lg border-8 border-white bg-slate-800 shadow-2xl"
            >
              <div
                class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-transparent to-transparent"
              >
              </div>

              <div
                class="absolute bottom-0 left-0 z-20 w-full space-y-2 p-8 text-white"
              >
                <div
                  class="mb-2 inline-block bg-kepler-gold px-3 py-1 text-xs font-black uppercase text-black"
                >
                  Polo Industrial Soyapango
                </div>
                <h2 class="text-3xl font-black uppercase leading-none">
                  Colegio Johan Kepler
                </h2>
                <p class="font-bold text-kepler-gold">
                  Parvularia • Educación Básica • Bachillerato
                </p>
              </div>

              <div
                class="flex h-full w-full items-center justify-center bg-slate-800"
              >
                <Image
                  src={fachadaImg}
                  alt="Fachada Colegio Kepler"
                  class="h-full w-full object-contain object-center"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- EL SEMANARIO / NOTICIAS -->
      <SemanarioSection />

      <!-- TARJETA INVITACIÓN A "NOSOTROS" -->
      <section class="mx-auto max-w-7xl px-4 py-8">
        <div
          class="flex flex-col items-center justify-between gap-8 rounded-2xl border-l-8 border-kepler-gold bg-slate-900 p-8 text-white shadow-2xl md:flex-row md:p-10"
        >
          <div class="max-w-2xl space-y-3 text-left">
            <span
              class="rounded bg-kepler-red px-3 py-1 text-[10px] font-black uppercase tracking-widest text-white"
            >
              ● Identidad Institucional
            </span>
            <h3
              class="text-2xl font-black uppercase tracking-tight md:text-3xl"
            >
              “TU FUTURO ESTÁ EN TUS MANOS”
            </h3>
            <p class="text-sm font-medium leading-relaxed text-slate-300">
              Conoce nuestra Misión, Visión y los valores cristianos sobre los
              cuales formamos integralmente a nuestros estudiantes en Soyapango.
            </p>
          </div>

          <a
            href="/acerca-de-nosotros"
            class="inline-flex items-center gap-3 whitespace-nowrap rounded-xl border-b-4 border-black/20 bg-kepler-gold px-8 py-4 text-xs font-black uppercase text-black shadow-lg transition-all hover:bg-yellow-400"
          >
            Conocer Misión y Visión
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="3"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
            >
          </a>
        </div>
      </section>

      <!-- HORARIOS ACADÉMICOS -->
      <section
        class="border-y-4 border-kepler-gold bg-black px-4 py-12 text-white"
      >
        <div
          class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-10 md:flex-row"
        >
          <div class="flex items-center gap-6">
            <div class="rounded-md bg-kepler-gold p-5 text-black shadow-lg">
              <svg
                class="h-10 w-10"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="3"
                ><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path></svg
              >
            </div>
            <div>
              <h2
                class="mb-1 text-3xl font-black uppercase leading-none tracking-tighter"
              >
                Horario Académico
              </h2>
              <p
                class="text-sm font-bold uppercase tracking-widest text-kepler-gold"
              >
                Para la familia trabajadora
              </p>
            </div>
          </div>
          <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 md:w-auto">
            <div
              class="rounded border-b-4 border-black bg-kepler-red p-5 text-center"
            >
              <p class="mb-1 text-xs font-black uppercase text-yellow-300">
                Lunes a Jueves
              </p>
              <p class="text-3xl font-black">06:00 - 15:00</p>
            </div>
            <div
              class="rounded border-b-4 border-black bg-slate-800 p-5 text-center"
            >
              <p class="mb-1 text-xs font-black uppercase text-kepler-gold">
                Viernes Consulta
              </p>
              <p class="text-3xl font-black uppercase tracking-tighter">
                Hasta 17:00
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CURRÍCULO MINED -->
      <section id="modelo" class="px-4 py-24">
        <div class="mx-auto max-w-7xl text-center">
          <h2
            class="text-4xl font-black uppercase tracking-tighter text-black md:text-5xl"
          >
            Educación de Alto Impacto
          </h2>
          <div class="mx-auto mb-6 h-2 w-24 bg-kepler-gold"></div>
          <p
            class="mx-auto mb-16 max-w-2xl text-balance text-lg font-bold text-slate-700"
          >
            Alineados estrictamente con el Ministerio de Educación para
            garantizar el éxito en la prueba AVANZO.
          </p>

          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
            <div
              class="rounded-lg border-l-8 border-kepler-red bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <h3 class="mb-2 text-xl font-black text-slate-900">ESMATE</h3>
              <p class="mb-4 text-sm font-bold uppercase text-slate-500">
                Razonamiento Matemático
              </p>
              <div class="text-sm font-black text-kepler-red">
                ✓ 192 Indicadores de Logro
              </div>
            </div>
            <div
              class="rounded-lg border-l-8 border-kepler-gold bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <h3 class="mb-2 text-xl font-black text-slate-900">ESLENGUA</h3>
              <p class="mb-4 text-sm font-bold uppercase text-slate-500">
                Comprensión Lectora
              </p>
              <div class="text-sm font-black text-kepler-red">
                ✓ Estándar Nacional 2024
              </div>
            </div>
            <div
              class="rounded-lg border-l-8 border-black bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <h3 class="mb-2 text-xl font-black text-slate-900">Tecnología</h3>
              <p class="mb-4 text-sm font-bold uppercase text-slate-500">
                Práctica en Laboratorios
              </p>
              <div class="text-sm font-black text-kepler-red">
                ✓ Alfabetización Digital
              </div>
            </div>
            <div
              class="rounded-lg border-l-8 border-kepler-red bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <h3 class="mb-2 text-xl font-black text-slate-900">Inglés</h3>
              <p class="mb-4 text-sm font-bold uppercase text-slate-500">
                Segunda Lengua
              </p>
              <div class="text-sm font-black text-kepler-red">
                ✓ Niveles PreA1 y A1
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- NIVELES EDUCATIVOS -->
      <section
        id="niveles"
        class="border-t border-slate-200 bg-slate-50 px-4 py-24"
      >
        <div class="mx-auto max-w-7xl text-center">
          <h2
            class="text-4xl font-black uppercase tracking-tighter text-black md:text-5xl"
          >
            Niveles Educativos
          </h2>
          <div class="mx-auto mb-12 h-2 w-24 bg-kepler-gold"></div>
          <div class="grid gap-8 text-left md:grid-cols-3">
            <div
              class="rounded-lg border-t-8 border-kepler-red bg-white p-8 shadow-md"
            >
              <span
                class="mb-2 block text-xs font-black uppercase tracking-widest text-kepler-red"
                >Educación Inicial</span
              >
              <h3 class="mb-4 text-2xl font-black uppercase">Parvularia</h3>
              <p
                class="mb-4 text-sm font-medium leading-relaxed text-slate-600"
              >
                Desarrollo integral, motricidad y primeras habilidades de
                lectoescritura en un ambiente seguro.
              </p>
              <span
                class="inline-block rounded bg-slate-100 px-3 py-1 text-xs font-bold text-slate-800"
                >K4 • K5 • K6</span
              >
            </div>
            <div
              class="rounded-lg border-t-8 border-kepler-gold bg-white p-8 shadow-md"
            >
              <span
                class="mb-2 block text-xs font-black uppercase tracking-widest text-kepler-gold"
                >I, II y III Ciclo</span
              >
              <h3 class="mb-4 text-2xl font-black uppercase">
                Educación Básica
              </h3>
              <p
                class="mb-4 text-sm font-medium leading-relaxed text-slate-600"
              >
                Formación sólida con programas ESMATE, ESLENGUA y laboratorio
                tecnológico.
              </p>
              <span
                class="inline-block rounded bg-slate-100 px-3 py-1 text-xs font-bold text-slate-800"
                >1° a 9° Grado</span
              >
            </div>
            <div
              class="rounded-lg border-t-8 border-black bg-white p-8 shadow-md"
            >
              <span
                class="mb-2 block text-xs font-black uppercase tracking-widest text-black"
                >Educación Media</span
              >
              <h3 class="mb-4 text-2xl font-black uppercase">Bachillerato</h3>
              <p
                class="mb-4 text-sm font-medium leading-relaxed text-slate-600"
              >
                Preparación académica de alto nivel enfocada en el examen AVANZO
                e ingreso universitario.
              </p>
              <span
                class="inline-block rounded bg-slate-100 px-3 py-1 text-xs font-bold text-slate-800"
                >General (2 Años)</span
              >
            </div>
          </div>
        </div>
      </section>

      <!-- RECORRIDO VIRTUAL / GALERÍA DE EVENTOS -->
      <VirtualTour />

      <!-- SECCIÓN SERVICIOS ADMINISTRATIVOS -->
      <AdministrativeServices />

      <!-- TARJETA COMUNIDAD DIGITAL (FACEBOOK) -->
      <section class="mx-auto max-w-7xl px-4 py-8">
        <SocialCard facebookUrl={OFFICIAL_FACEBOOK} />
      </section>

      <!-- SECCIÓN DE UBICACIÓN INTERACTIVA -->
      <section id="ubicacion" class="mx-auto max-w-7xl px-4 py-12">
        <div
          class="space-y-8 rounded-2xl border-t-8 border-kepler-red bg-slate-900 p-8 text-white shadow-2xl md:p-12"
        >
          <div class="space-y-3 text-center">
            <span
              class="inline-block rounded bg-kepler-gold px-4 py-1 text-[10px] font-black uppercase tracking-widest text-black"
            >
              📍 Encuéntranos Fácilmente
            </span>
            <h2
              class="text-3xl font-black uppercase tracking-tight md:text-5xl"
            >
              Nuestra Ubicación
            </h2>
            <p
              class="mx-auto max-w-xl text-sm font-medium text-slate-300 md:text-base"
            >
              Visítanos en el corazón de Soyapango. Estamos listos para
              atenderte y darte la bienvenida a la familia Kepler.
            </p>
          </div>

          <div
            class="h-[450px] w-full overflow-hidden rounded-xl border-4 border-white/10 shadow-inner"
          >
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1131.9353096884083!2d-89.15353793009183!3d13.699321293731488!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f633724994d8125%3A0x78e170434ebff40b!2sColegio%20Johan%20Kepler!5e0!3m2!1ses-419!2ssv!4v1785116904186!5m2!1ses-419!2ssv"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Ubicación Colegio Johan Kepler"></iframe>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER INSTITUCIONAL -->
    <footer
      id="contacto"
      class="border-t-8 border-kepler-red bg-black px-4 py-20 text-white"
    >
      <div class="mx-auto grid max-w-7xl gap-12 text-left md:grid-cols-3">
        <!-- Identidad -->
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div
              class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-full border-2 border-slate-700 bg-white/10"
            >
              <Image
                src={logoImg}
                alt="Logo Colegio Johan Kepler"
                class="h-full w-full object-contain"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-3xl font-black uppercase tracking-tighter"
                >COLEGIO</span
              >
              <span
                class="text-2xl font-bold uppercase leading-none text-kepler-red"
                >Johan Kepler</span
              >
            </div>
          </div>
          <p class="font-medium leading-relaxed text-slate-400">
            "La escuela es territorio y el territorio es educación". Somos el
            portal de movilidad social para el polo industrial de Soyapango.
          </p>
        </div>

        <!-- Ubicación y Admisiones -->
        <div class="space-y-6">
          <h4
            class="text-sm font-black uppercase tracking-widest text-kepler-gold"
          >
            Ubicación y Admisiones
          </h4>
          <p class="text-sm font-medium leading-relaxed text-slate-400">
            Calle Principal #6, Soyapango, San Salvador.<br />
            Cerca del centro logístico e industrial.
          </p>
          <div class="text-xl font-black text-kepler-red">TEL: 2255-1500</div>
        </div>

        <!-- Marco Normativo -->
        <div class="space-y-6">
          <h4
            class="text-sm font-black uppercase tracking-widest text-kepler-gold"
          >
            Marco Normativo y Enlaces
          </h4>
          <ul class="space-y-2 text-sm font-bold uppercase text-slate-400">
            <li>
              <a
                href="/acerca-de-nosotros"
                class="transition-colors hover:text-kepler-gold"
                >• Acerca de Nosotros</a>
            </li>
            <li>• Ministerio de Educación</li>
            <li>• Prueba AVANZO 2026</li>
            <li>• Ley Crecer Juntos</li>
          </ul>
        </div>
      </div>

      <div
        class="mx-auto mt-16 max-w-7xl border-t border-white/10 pt-8 text-center text-[10px] font-black uppercase tracking-widest text-slate-600"
      >
        © 2026 COLEGIO JOHAN KEPLER - CALIDAD INTERNACIONAL A VALOR LOCAL
      </div>
    </footer>

    <script>
      const t = document.getElementById("menu-btn");
      const e = document.getElementById("mobile-menu");
      const d = document.querySelectorAll(".mobile-link");

      t?.addEventListener("click", () => {
        e?.classList.toggle("hidden");
      });

      d.forEach((n) => {
        n.addEventListener("click", () => {
          e?.classList.add("hidden");
        });
      });
    </script>
