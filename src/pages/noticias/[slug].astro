---
// src/pages/noticias/[slug].astro
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import logoImg from "../../assets/logo.png";

export async function getStaticPaths() {
  const noticias = await getCollection("noticias");
  return noticias.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{entry.data.title} | Colegio Johan Kepler</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-kepler-aqua font-sans text-slate-900 antialiased"
  >
    <!-- NAVBAR SIMPLIFICADO -->
    <nav class="w-full border-b-8 border-kepler-gold bg-white shadow-md">
      <div
        class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
      >
        <a href="/" class="flex items-center gap-3">
          <div
            class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full border-2 border-slate-200 bg-white"
          >
            <Image
              src={logoImg}
              alt="Logo Colegio Johan Kepler"
              class="h-full w-full object-contain"
            />
          </div>
          <div class="flex flex-col">
            <span
              class="text-xl font-black uppercase leading-none tracking-tighter text-black"
              >Colegio</span
            >
            <span
              class="text-lg font-bold leading-none tracking-tight text-kepler-red"
              >Johan Kepler</span
            >
          </div>
        </a>

        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-md bg-slate-900 px-4 py-2 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-slate-800"
        >
          &larr; Volver al Inicio
        </a>
      </div>
    </nav>

    <!-- CONTENIDO DE LA NOTICIA -->
    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-12">
      <article
        class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl md:p-12"
      >
        <!-- Aviso Urgente Banner si aplica -->
        {
          entry.data.urgent && (
            <div class="mb-6 inline-flex items-center gap-2 rounded bg-kepler-red px-3 py-1 text-xs font-black uppercase tracking-widest text-white">
              <span>⚠️ Aviso Urgente Oficial</span>
            </div>
          )
        }

        <!-- Meta información -->
        <div class="mb-4 flex items-center gap-3 text-xs font-bold">
          <span
            class="rounded bg-[#006837]/10 px-2.5 py-1 uppercase tracking-wide text-[#006837]"
          >
            {entry.data.category}
          </span>
          <span class="text-slate-400">•</span>
          <time class="text-slate-500">
            {
              new Date(entry.data.date).toLocaleDateString("es-SV", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })
            }
          </time>
        </div>

        <!-- Título -->
        <h1
          class="mb-6 text-3xl font-black leading-tight text-[#006837] md:text-5xl"
        >
          {entry.data.title}
        </h1>

        <!-- Resumen / Bajada -->
        {
          entry.data.summary && (
            <p class="mb-8 border-l-4 border-kepler-gold pl-4 text-lg font-medium italic leading-relaxed text-slate-600">
              {entry.data.summary}
            </p>
          )
        }

        <!-- Imagen Destacada -->
        {
          entry.data.image && (
            <div class="mb-10 flex aspect-video items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
              <img
                src={entry.data.image}
                alt={entry.data.title}
                class="h-full w-full object-cover"
              />
            </div>
          )
        }

        <!-- Cuerpo del Markdown -->
        <div
          class="prose prose-slate max-w-none space-y-4 text-base leading-relaxed text-slate-800 md:text-lg"
        >
          <Content />
        </div>

        <!-- Botón de regreso inferior -->
        <div
          class="mt-12 flex items-center justify-between border-t border-slate-200 pt-6"
        >
          <a
            href="/"
            class="inline-flex items-center gap-1 text-sm font-black uppercase tracking-wider text-[#006837] transition-colors hover:text-black"
          >
            &larr; Volver a las noticias
          </a>
        </div>
      </article>
    </main>

    <!-- FOOTER CORTO -->
    <footer
      class="mt-12 border-t-4 border-kepler-gold bg-black py-6 text-center text-xs font-bold uppercase tracking-widest text-white"
    >
      © 2026 COLEGIO JOHAN KEPLER - SOYAPANGO
    </footer>
  </body>
</html>
