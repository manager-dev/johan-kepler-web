---
import Layout from '../layouts/Layout.astro';
import ExpedienteDashboard from '../components/ExpedienteDashboard.jsx';
---

<Layout title="Expediente Kepler - Control Académico Digital">
    {/* Barra superior de navegación del módulo */}
    <header class="bg-white border-b-8 border-kepler-gold shadow-md py-6 px-4 fixed w-full z-50">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10">
                    <img src="/assets/logo.png" alt="Logo Kepler" class="w-full h-full object-contain" />
                </div>
                <div class="flex flex-col text-left">
                    <span class="text-lg font-black text-black leading-none uppercase tracking-tighter">Expediente</span>
                    <span class="text-xs font-bold text-kepler-red leading-none tracking-tight uppercase">Johan Kepler</span>
                </div>
            </div>
            <a href="/" class="border-2 border-black text-black px-4 py-2 rounded font-black uppercase text-xs hover:bg-slate-50 transition-colors">
                🡨 Volver al Inicio
            </a>
        </div>
    </header>

    <main class="pt-32 pb-20 px-4 max-w-7xl mx-auto text-center">
        <div class="mb-12">
            <h1 class="text-4xl md:text-5xl font-black text-black uppercase tracking-tighter">Portal de Información Estudiantil</h1>
            <div class="w-16 h-2 bg-kepler-gold mx-auto mt-2"></div>
        </div>

        {/* Inyección del Dashboard con hidratación del lado del cliente */}
        <ExpedienteDashboard client:only="solid-js" />
    </main>
</Layout>