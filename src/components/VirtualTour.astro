---
// src/components/VirtualTour.astro
import { Image } from 'astro:assets';

// Carga dinámica de todas las imágenes de ambas carpetas
const imagenesCivica = await Astro.glob('../assets/galeria/manana-civica/*.{jpg,png,jpeg,JPG,PNG}');
const imagenesFeria = await Astro.glob('../assets/galeria/feria-logros/*.{jpg,png,jpeg,JPG,PNG}');
---

<section id="recorrido" class="max-w-7xl mx-auto px-4 py-16 space-y-12">

    <!-- Encabezado de la Sección -->
    <div class="text-center space-y-4">
    <span class="inline-block bg-kepler-red text-white text-xs font-black uppercase tracking-[0.2em] px-4 py-1.5 rounded-md">
      ● Eventos e Infraestructura
    </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase text-black">
            Galería Institucional & Recorrido
        </h2>
        <div class="w-24 h-2 bg-kepler-gold mx-auto"></div>
        <p class="text-slate-700 font-medium max-w-2xl mx-auto text-base">
            Explora nuestras actividades, eventos cívicos y la feria de logros que reflejan la vivencia estudiantil en el Colegio Johan Kepler.
        </p>
    </div>

    <!-- CATEGORÍA 1: MAÑANA CÍVICA -->
    <div class="space-y-6">
        <div class="flex items-center gap-4 border-b-4 border-kepler-red pb-3">
            <span class="bg-kepler-red text-white text-xs font-black uppercase px-3 py-1 rounded">Categoría</span>
            <h3 class="text-2xl font-black uppercase text-slate-900">Mañana Cívica</h3>
        </div>

        <!-- Grid Responsivo de 10 Imágenes -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
            {imagenesCivica.map((img, index) => (
                    <div class="group relative rounded-lg overflow-hidden border-2 border-slate-200 bg-slate-900 aspect-square shadow-md hover:shadow-xl transition-all duration-300">
                        <Image
                                src={img.default}
                                alt={`Mañana Cívica Foto ${index + 1}`}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                            <span class="text-white text-[10px] font-black uppercase tracking-wider">Foto #{index + 1}</span>
                        </div>
                    </div>
            ))}
        </div>
    </div>

    <!-- CATEGORÍA 2: FERIA DE LOGROS -->
    <div class="space-y-6 pt-8">
        <div class="flex items-center gap-4 border-b-4 border-kepler-gold pb-3">
            <span class="bg-kepler-gold text-black text-xs font-black uppercase px-3 py-1 rounded">Categoría</span>
            <h3 class="text-2xl font-black uppercase text-slate-900">Feria de Logros</h3>
        </div>

        <!-- Grid Responsivo de 10 Imágenes -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
            {imagenesFeria.map((img, index) => (
                    <div class="group relative rounded-lg overflow-hidden border-2 border-slate-200 bg-slate-900 aspect-square shadow-md hover:shadow-xl transition-all duration-300">
                        <Image
                                src={img.default}
                                alt={`Feria de Logros Foto ${index + 1}`}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                            <span class="text-white text-[10px] font-black uppercase tracking-wider">Foto #{index + 1}</span>
                        </div>
                    </div>
            ))}
        </div>
    </div>

</section>