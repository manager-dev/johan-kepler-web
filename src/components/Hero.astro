---
// src/components/Hero.astro
interface Props {
    title?: string;
    subtitle?: string;
    facebookUrl?: string;
}

const {
    title = "Colegio Cristiano Johan Kepler",
    subtitle = "Formando líderes con principios, ciencia y valores cristianos. Sigue nuestras actividades, fotos y avisos en nuestra comunidad digital.",
    facebookUrl
} = Astro.props;
---

<section class="relative overflow-hidden rounded-3xl bg-slate-900 text-white shadow-2xl my-6">
    <!-- Fondo decorativo con gradiente -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/80 via-slate-900 to-slate-950 -z-0"></div>

    <!-- Patrón de malla sutil -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 -z-0"></div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 py-12 sm:py-16 lg:px-8">
        <div class="max-w-2xl">

            <!-- Badge Medios Activos -->
            <span class="inline-flex items-center gap-2 rounded-full bg-blue-500/10 border border-blue-400/20 px-3.5 py-1.5 text-xs font-semibold text-blue-300 backdrop-blur-md">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        Medios Activos & Actualizaciones
      </span>

            <!-- Título Principal -->
            <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-white sm:text-5xl leading-tight">
                {title}
            </h1>

            <!-- Subtítulo -->
            <p class="mt-4 text-base text-slate-300 sm:text-lg leading-relaxed">
                {subtitle}
            </p>

            <!-- Botón de Acción a Facebook (Se muestra solo si existe la URL) -->
            {facebookUrl && (
                    <div class="mt-8 flex flex-wrap gap-4 items-center">
                        <a
                                href={facebookUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2.5 rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/30 transition-all duration-200 hover:bg-blue-500 hover:shadow-blue-500/40 hover:-translate-y-0.5 active:translate-y-0"
                        >
                            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                            Ver Actividades en Facebook
                        </a>
                    </div>
            )}

        </div>
    </div>
</section>