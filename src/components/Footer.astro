---
// src/components/Footer.astro
interface Props {
    facebookUrl?: string;
}

const { facebookUrl } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800/80 mt-16">
    <div class="mx-auto max-w-7xl px-6 py-12 md:flex md:items-center md:justify-between lg:px-8">

        <!-- Bloque Informativo -->
        <div class="space-y-2">
            <h3 class="text-base font-bold text-white tracking-wide">
                Colegio Cristiano Johan Kepler
            </h3>
            <p class="text-sm text-slate-400 max-w-md">
                Educación integral basada en excelencia académica y valores bíblicos.
            </p>
        </div>

        <!-- Barra de Redes Sociales (Facebook únicamente) -->
        {facebookUrl && (
                <div class="mt-8 flex items-center space-x-6 md:mt-0">
                    <a
                            href={facebookUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 transition-all duration-200 hover:border-blue-500/50 hover:text-blue-400 hover:bg-slate-800"
                            aria-label="Página de Facebook"
                    >
                        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                    </a>
                </div>
        )}

    </div>

    <!-- Copyright -->
    <div class="border-t border-slate-900 bg-slate-950 py-4 text-center text-xs text-slate-500">
        © {currentYear} Colegio Cristiano Johan Kepler. Todos los derechos reservados.
    </div>
</footer>