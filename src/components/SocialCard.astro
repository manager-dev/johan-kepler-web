---
// src/components/SocialCard.astro
interface Props {
    facebookUrl: string;
}

const { facebookUrl } = Astro.props;
---

<div class="relative overflow-hidden rounded-xl bg-slate-900 border-2 border-kepler-gold p-8 text-white shadow-2xl">
    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">

        <div class="space-y-3 max-w-xl">
      <span class="inline-flex items-center gap-2 rounded-md bg-kepler-red text-white px-3 py-1 text-xs font-black uppercase tracking-widest">
        ● Comunidad Digital & Avisos
      </span>

            <h3 class="text-2xl font-black uppercase text-white tracking-tight">
                Sigue nuestras noticias y actividades
            </h3>

            <p class="text-sm text-slate-300 font-medium leading-relaxed">
                Publicamos constantemente fotografías, eventos institucionales, avisos a padres de familia y comunicados oficiales en nuestra página oficial de Facebook.
            </p>
        </div>

        <div class="flex-shrink-0">
            <a
                    href={facebookUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 rounded-md bg-kepler-red px-6 py-3.5 text-xs font-black text-white uppercase tracking-wider shadow-md hover:bg-kepler-redDark transition-all border-b-4 border-black/20"
            >
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Visitar Facebook Oficial
            </a>
        </div>

    </div>
</div>