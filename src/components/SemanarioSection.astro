---
// src/components/SemanarioSection.astro
import { getCollection } from 'astro:content';

const todasLasNoticias = (await getCollection('noticias')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const noticiaPrincipal = todasLasNoticias[0];
const noticiasSecundarias = todasLasNoticias.slice(1, 7);
---

<section class="max-w-7xl mx-auto px-4 py-12">
  <!-- Encabezado institucional -->
  <div class="mb-8 border-b-2 border-slate-200 pb-2">
    <div class="inline-block relative">
      <h2 class="text-2xl md:text-3xl font-extrabold text-[#006837] tracking-tight">
        El Semanario
      </h2>
      <div class="h-1 bg-[#006837] w-full mt-1.5 rounded-full"></div>
    </div>
  </div>

  {todasLasNoticias.length === 0 ? (
    <div class="bg-white/80 border border-slate-200 rounded-lg p-8 text-center text-slate-500 font-medium">
      No hay publicaciones disponibles en este momento.
    </div>
  ) : (
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Columna Izquierda: Noticia Principal -->
      {noticiaPrincipal && (
        <article class="lg:col-span-5 flex flex-col group">
          <a href={`/noticias/${noticiaPrincipal.slug}`} class="overflow-hidden rounded-md mb-4 block bg-slate-200 aspect-[4/3] border border-slate-200 shadow-sm">
            {noticiaPrincipal.data.image ? (
              <img
                src={noticiaPrincipal.data.image}
                alt={noticiaPrincipal.data.title}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="eager"
              />
            ) : (
              <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400 font-bold">
                Sin imagen
              </div>
            )}
          </a>

          <h3 class="text-xl md:text-2xl font-bold leading-snug text-[#006837] hover:text-[#004d28] transition-colors">
            <a href={`/noticias/${noticiaPrincipal.slug}`}>
              {noticiaPrincipal.data.title}
            </a>
          </h3>

          <div class="flex items-center gap-1.5 text-xs text-slate-500 mt-2.5">
            <svg class="w-4 h-4 text-slate-400 stroke-current flex-shrink-0" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <time>
              {new Date(noticiaPrincipal.data.date).toLocaleDateString('es-SV', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
              })}
            </time>
          </div>
        </article>
      )}

      <!-- Columna Derecha: Grid de Noticias Secundarias -->
      <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
        {noticiasSecundarias.map((item) => (
          <article class="flex gap-3.5 items-start group">
            <a
              href={`/noticias/${item.slug}`}
              class="w-24 h-20 flex-shrink-0 overflow-hidden rounded-md bg-slate-200 block border border-slate-200"
            >
              {item.data.image ? (
                <img
                  src={item.data.image}
                  alt={item.data.title}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-slate-200 flex items-center justify-center text-xs text-slate-400 font-medium">
                  Foto
                </div>
              )}
            </a>

            <div class="flex-1 min-w-0">
              <h4 class="text-sm font-bold text-[#006837] leading-snug line-clamp-3 hover:text-[#004d28] transition-colors mb-1.5">
                <a href={`/noticias/${item.slug}`}>
                  {item.data.title}
                </a>
              </h4>

              <div class="flex items-center gap-1.5 text-[11px] text-slate-500">
                <svg class="w-3.5 h-3.5 text-slate-400 stroke-current flex-shrink-0" fill="none" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <time>
                  {new Date(item.data.date).toLocaleDateString('es-SV', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                  })}
                </time>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  )}
</section>